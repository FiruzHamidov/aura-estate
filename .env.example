APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

GUEST_SUPPORT_COOKIE=aura_guest_support
GUEST_SUPPORT_LIFETIME_MINUTES=43200
GUEST_SUPPORT_COOKIE_SECURE=true
GUEST_SUPPORT_COOKIE_SAME_SITE=lax
GUEST_SUPPORT_CREATE_RATE_PER_MINUTE=5
GUEST_SUPPORT_READ_RATE_PER_MINUTE=60
GUEST_SUPPORT_MESSAGE_RATE_PER_MINUTE=15
FIREBASE_CREDENTIALS=/absolute/path/to/firebase-service-account.json

PROPERTY_LISTING_DATE_REFRESH_COOLDOWN_SECONDS=86400

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
LOCATION_REALTIME_BROADCAST_ENABLED=false
MESSAGING_REALTIME_BROADCAST_ENABLED=false
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=aura-estate
REVERB_APP_KEY=replace-with-public-app-key
REVERB_APP_SECRET=replace-with-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=http://localhost:5173
REVERB_APP_ACCEPT_CLIENT_EVENTS_FROM=none

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE=https://api.openai.com
RELAY_SHARED_KEY=
DAILY_REPORT_ENFORCE_SUBMISSION=true
DAILY_REPORT_ENFORCED_ROLES=agent,mop,intern
DAILY_REPORT_MISSING_CHECK_TIME=00:00
DAILY_REPORT_SUBMIT_START_TIME=20:00

ATTENDANCE_TIMEZONE=Asia/Dushanbe
ATTENDANCE_DEVICE_REQUEST_MAX_BYTES=262144
ATTENDANCE_DEVICE_RATE_LIMIT_PER_MINUTE=240
ATTENDANCE_DUPLICATE_WINDOW_SECONDS=10
ATTENDANCE_OFFLINE_THRESHOLD_MINUTES=10
ATTENDANCE_CLOCK_DRIFT_WARNING_SECONDS=300
ATTENDANCE_CLOCK_DRIFT_MEASUREMENT_WINDOW_SECONDS=1800
ATTENDANCE_RAW_RETENTION_DAYS=90
ATTENDANCE_QUEUE_STALE_AFTER_MINUTES=15
# Optional comma-separated public office IPs. Empty means serial/key checks only.
ATTENDANCE_ALLOWED_IPS=

# Property moderation: any price increase requires independent review by default.
PROPERTY_PRICE_INCREASE_REVIEW_PERCENT=0
PROPERTY_PROMOTION_DEFAULT_DAYS=7
PROPERTY_PROMOTION_MAX_DAYS=30
PROPERTY_TRUST_WINDOW_DAYS=90
PROPERTY_TRUST_REPEAT_MULTIPLIER=1.5
